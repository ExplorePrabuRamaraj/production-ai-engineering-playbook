# Copy this file to .env and fill in your values
# Never commit .env to source control

# Authentication token for MCP server (SSE transport)
# Leave blank to run in demo mode (no server needed)
BEARER_TOKEN=your-bearer-token-here

# Transport mode: "stdio" (local subprocess) or "sse" (remote HTTP)
MCP_TRANSPORT=stdio

# SSE transport settings (only used when MCP_TRANSPORT=sse)
SSE_HOST=0.0.0.0
SSE_PORT=8000

# Server identity
SERVER_NAME=document-search-server
SERVER_VERSION=1.0.0

# Set to "true" to run without any external services
DEMO_MODE=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path for structured tool-call logs
TOOL_LOG_PATH=tool_calls.log

# Hard cap on search results returned per call
MAX_RESULTS=20
