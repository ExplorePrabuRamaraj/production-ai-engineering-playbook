# W2D3 — GraphRAG & Knowledge Graphs
# No real values. Copy to .env and fill in before running in live mode.
# Never commit .env to source control.

OPENAI_API_KEY=your-openai-api-key
MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=1000

# GraphRAG-specific settings
HOP_DEPTH=2
MAX_NODES_PER_TRAVERSAL=30
MIN_EDGE_WEIGHT=1
LEIDEN_GAMMA=1.0
TOP_K_VECTOR=5
TOP_K_MERGED=8
RRF_K=60

# Set to true to run offline demo without an API key
DEMO_MODE=false
