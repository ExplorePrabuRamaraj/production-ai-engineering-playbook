# Copy this file to .env and fill in your values.
# Never commit .env to source control — it is listed in .gitignore.

OPENAI_API_KEY=your-openai-api-key-here
MODEL=openai:gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=500

# Number of retry attempts when schema validation fails (default: 2)
SCHEMA_RETRIES=2

# Set to "true" to run without an API key (uses pre-computed demo output)
DEMO_MODE=false
