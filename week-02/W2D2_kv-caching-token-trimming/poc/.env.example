# Copy this file to .env and fill in your values
# Never commit .env to source control

OPENAI_API_KEY=your-openai-api-key-here
MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=500

# Maximum tokens allowed in the dynamic conversation suffix (excluding static prefix)
MAX_CONTEXT_TOKENS=4000

# Fraction of history eviction that triggers summary compression (0.0 to 1.0)
# At 0.5: compression fires when >50% of history is evicted in one pass
COMPRESSION_THRESHOLD=0.5

# Set to "true" to run without an API key (uses pre-computed demo output)
DEMO_MODE=false
