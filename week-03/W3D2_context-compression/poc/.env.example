# Copy this file to .env and fill in your values
# Never commit .env to source control

OPENAI_API_KEY=your-openai-api-key-here
MODEL=gpt-4o-mini

# Model used for abstractive compression (can be cheaper than the main model)
COMPRESSION_MODEL=gpt-4o-mini

TEMPERATURE=0.0
MAX_TOKENS=1000

# Total token budget for the compressed context (distributed across all segments)
TOKEN_BUDGET=1000

# Compression strategy: extractive | abstractive | hybrid
COMPRESSION_STRATEGY=extractive

# Segments smaller than this token count bypass compression entirely
MIN_SEGMENT_TOKENS=50

# Set to "true" to run without an API key (uses extractive demo mode)
DEMO_MODE=false
