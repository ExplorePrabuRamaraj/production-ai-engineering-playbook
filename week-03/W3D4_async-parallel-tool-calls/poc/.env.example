# Copy this file to .env and fill in your values
# Never commit .env to source control — it is listed in .gitignore

OPENAI_API_KEY=your-openai-api-key-here
MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=500

# Async dispatcher settings
MAX_CONCURRENT_TOOLS=5    # asyncio.Semaphore limit — lower this if hitting rate limits
TOOL_TIMEOUT_S=2.0        # Per-tool deadline in seconds

# Set to "true" to run without an API key (uses mock tools with simulated latencies)
DEMO_MODE=false
