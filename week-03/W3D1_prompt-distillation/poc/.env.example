# W3D1 — Prompt Distillation — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# OpenAI API key — leave blank to run in demo mode (no API calls)
OPENAI_API_KEY=your-openai-api-key-here

# LLM model used for classification scoring during distillation
# gpt-4o-mini is recommended: lowest cost, sufficient accuracy for classification
MODEL=gpt-4o-mini

# Sampling temperature — keep at 0.0 for deterministic classification
TEMPERATURE=0.0

# Max tokens for the LLM response (category label is <=10 tokens)
MAX_TOKENS=16

# Set to "true" to run the demo without any API key
DEMO_MODE=false

# Minimum accuracy the student prompt must retain vs the teacher (0.0–1.0)
# Default 0.90 = student must keep >=90% of teacher accuracy
ACCURACY_FLOOR=0.90

# Maximum pruning iterations in the distillation loop
MAX_DISTILLATION_ITERATIONS=5

# Daily call volume used for cost-savings projection
DAILY_CALLS=6667

# Input token price in USD per 1 million tokens (gpt-4o-mini, mid-2025)
COST_PER_1M_TOKENS=0.15
