# W3D3 — Hybrid Search & Reranking
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# OpenAI API key — required only for live embedding generation
# Leave blank to run in demo mode (no API call)
OPENAI_API_KEY=your-openai-api-key-here

# Embedding model for dense retrieval (live mode only)
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# LLM generation settings
TEMPERATURE=0.0
MAX_TOKENS=1000

# Set to "true" to run without API key (pre-computed output)
DEMO_MODE=false

# Retrieval tuning
BM25_TOP_K=100
DENSE_TOP_K=100
RRF_K=60
FUSION_TOP_N=50
RERANKER_TOP_K=5

# Set to "false" to skip cross-encoder reranking (return RRF results directly)
USE_RERANKER=true
