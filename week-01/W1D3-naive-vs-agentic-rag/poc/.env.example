# Copy this file to .env and fill in your values
# Never commit .env to source control

OPENAI_API_KEY=your-openai-api-key-here

# Model used for answer synthesis (the main LLM call)
MODEL=gpt-4o-mini

# Model used for query decomposition and evidence validation
# Use a smaller/cheaper model here to reduce cost per query
DECOMPOSITION_MODEL=gpt-4o-mini

TEMPERATURE=0.0
MAX_TOKENS=1000

# Retrieval settings
TOP_K=5
SIMILARITY_THRESHOLD=0.70
MAX_SUB_QUESTIONS=4
MAX_REFORMULATION_RETRIES=2

# Set to "true" to run without an API key using pre-computed demo corpus
DEMO_MODE=false
