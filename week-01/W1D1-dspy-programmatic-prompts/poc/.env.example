# W1D1 — DSPy & Programmatic Prompts
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# OpenAI API key (required for live mode)
OPENAI_API_KEY=

# DSPy model to use (default: gpt-4o-mini)
DSPY_MODEL=gpt-4o-mini

# Temperature for LM calls (0.0 = deterministic, recommended for structured output)
DSPY_TEMPERATURE=0.0

# Set to "true" to run in demo mode without consuming API credits
DEMO_MODE=false
