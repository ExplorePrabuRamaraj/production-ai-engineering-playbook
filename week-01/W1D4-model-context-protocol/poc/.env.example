# Copy this file to .env and fill in your values
# Never commit .env to source control — it is listed in .gitignore

# LLM provider (optional — demo mode runs without this)
OPENAI_API_KEY=your-openai-api-key-here
MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=1000

# Set to "true" to run the in-process demo without any API key
DEMO_MODE=false

# MCP server configuration
MCP_SERVER_NAME=demo-crm-server
MCP_PROTOCOL_VERSION=2024-11-05

# Transport: "stdio" for local subprocess, "http" for remote server
MCP_TRANSPORT=stdio

# Required only when MCP_TRANSPORT=http
MCP_SERVER_URL=http://localhost:8000
MCP_BEARER_TOKEN=your-bearer-token-here
