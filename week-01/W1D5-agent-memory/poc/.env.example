# Copy this file to .env and fill in your values
# Never commit .env to source control — it is listed in .gitignore

# OpenAI API key — required for live mode, optional for demo mode
OPENAI_API_KEY=your-openai-api-key-here

# LLM model to use in live mode
MODEL=gpt-4o-mini

# Inference settings
TEMPERATURE=0.0
MAX_TOKENS=500

# Set to "true" to run without an API key (pre-computed output)
DEMO_MODE=false

# Memory retrieval settings
EPISODIC_TOP_K=3
SEMANTIC_TOP_K=2
RECENCY_WEIGHT_ALPHA=0.3
RECENCY_DAYS=30

# Promotion pipeline settings
PROMOTION_MIN_EVIDENCE=3
SEMANTIC_TTL_DAYS=90

# Token budgets for working memory assembly
EPISODIC_TOKEN_BUDGET=1200
SEMANTIC_TOKEN_BUDGET=800

# Qdrant vector DB — leave empty to use in-memory store (demo only)
QDRANT_URL=

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
