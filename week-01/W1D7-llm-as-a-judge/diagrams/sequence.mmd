%% W1D7 — LLM-as-a-Judge Evals — Evaluation Request Flow
sequenceDiagram
    autonumber
    actor Pipeline as Eval Pipeline
    participant Redactor as PII Redactor
    participant Builder as Prompt Builder
    participant Rubrics as Rubric Registry
    participant Judge as Judge LLM
    participant Parser as Output Parser
    participant Store as Verdict Store
    participant Queue as Human Review Queue

    Pipeline->>Redactor: Strip PII from prompt + response
    Redactor-->>Pipeline: sanitised_prompt, sanitised_response
    Pipeline->>Rubrics: FetchRubric(version="v2.1")
    Rubrics-->>Pipeline: rubric_criteria, output_schema
    Pipeline->>Builder: Assemble(sanitised_prompt, sanitised_response, rubric_v2.1)
    Builder-->>Pipeline: judge_prompt
    Pipeline->>Judge: Complete(judge_prompt, temp=0.0, format=json_object)
    Judge-->>Pipeline: raw_completion

    alt JSON is valid and schema matches
        Pipeline->>Parser: Validate(raw_completion, output_schema)
        Parser-->>Pipeline: structured_verdict
        Note over Parser: Check score ranges 1-3, rationale present for score < 3
        Pipeline->>Store: Save(verdict, rubric_version, timestamp, parse_attempts=1)

        alt verdict=fail OR confidence=low
            Store->>Queue: Route(verdict, rationale, original_request)
            Note over Queue: Human reviewer assigned per SLA
        else verdict=pass AND confidence=high or medium
            Store-->>Pipeline: Stored, pipeline continues
        end

    else JSON parse failure — retry
        Pipeline->>Judge: Complete(judge_prompt + correction_hint, temp=0.1)
        Judge-->>Pipeline: corrected_completion
        Pipeline->>Parser: Validate(corrected_completion, output_schema)

        alt Second parse succeeds
            Parser-->>Pipeline: structured_verdict
            Pipeline->>Store: Save(verdict, rubric_version, parse_attempts=2)
        else Second parse also fails
            Pipeline->>Queue: Route(raw_output, parse_error, original_request)
            Note over Queue: Flagged as parse_failure — manual verdict required
        end
    end
