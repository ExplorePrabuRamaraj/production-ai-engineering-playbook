# Copy this file to .env and fill in your values.
# Never commit .env to source control — it is listed in .gitignore.

# OpenAI API key — required for live mode
OPENAI_API_KEY=your-openai-api-key-here

# Judge model — use a different family from the generator for unbiased evaluation
# Recommended: gpt-4o-mini (cost-efficient), gpt-4o (highest agreement with humans)
JUDGE_MODEL=gpt-4o-mini

# Generator model (only used in extended live mode)
MODEL=gpt-4o-mini

# Judge temperature — keep at 0.0 for deterministic, auditable verdicts
TEMPERATURE=0.0

# Maximum tokens for judge response
MAX_TOKENS=500

# Rubric version — must match a key in RUBRICS dict in judge_core.py
RUBRIC_VERSION=v1.0

# Maximum retries when judge returns malformed JSON
MAX_JUDGE_RETRIES=2

# Set to "true" to run without an API key (uses pre-computed demo output)
DEMO_MODE=false
