# Copy this file to .env and fill in your values.
# Never commit .env to source control — it is listed in .gitignore.

# OpenAI API key — required for live mode LLM node calls
# Leave blank to run in demo mode (no API call, pre-computed output)
OPENAI_API_KEY=your-openai-api-key-here

# Model to use for LLM node calls
MODEL=gpt-4o-mini

# LLM sampling temperature — 0.0 for deterministic classification output
TEMPERATURE=0.0

# Maximum tokens per LLM response
MAX_TOKENS=500

# Set to "true" to force demo mode even when OPENAI_API_KEY is present
DEMO_MODE=false

# Risk score threshold above which documents route to the high-risk path (0.0–1.0)
RISK_THRESHOLD=0.7

# Maximum retries before routing to the error terminal node
MAX_RETRIES=3

# LangSmith tracing (optional — leave blank to disable)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=w1d6-state-graphs-langgraph
